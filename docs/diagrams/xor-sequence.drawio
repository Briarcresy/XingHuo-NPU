nt="1" source="l1" target="h"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-17" as="offset"/></mxGeometry></mxCell><mxCell id="e3" value="H" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#526b80;strokeWidth=1.7;fontFamily=Helvetica;fontSize=15;fontColor=#43576a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="h" target="a2"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-17" as="offset"/></mxGeometry></mxCell><mxCell id="e4" value="W2 / H / B2 / Shift2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#526b80;strokeWidth=1.7;fontFamily=Helvetica;fontSize=15;fontColor=#43576a;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=5 4;" edge="1" parent="1" source="a2" target="l2"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-17" as="offset"/></mxGeometry></mxCell><mxCell id="e5" value="Y" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#526b80;strokeWidth=1.7;fontFamily=Helvetica;fontSize=15;fontColor=#43576a;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=5 4;" edge="1" parent="1" source="l2" target="finish"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-17" as="offset"/></mxGeometry></mxCell><mxCell id="center" value="Layer 2 consumes the actual Layer 1 hardware result.&#xa;Each layer uses Weight, Start and Result ready/valid channels." style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#43576a;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="290" width="590" height="65" as="geometry"/></mxCell><mxCell id="note" value="Network busy spans the whole sequence. The controller owns Shared RAM until completion.&#xa;Classification uses the first row: Y01 &gt; Y00 gives class 1; otherwise class 0." style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#43576a;fontFamily=Helvetica;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="565" width="1030" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
