<mxfile host="app.diagrams.net" version="31.3.2"><diagram id="xor-sequence" name="XorNetworkController · two-layer execution"><mxGraphModel dx="1120" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="640" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="XorNetworkController · two-layer execution" style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#43576a;fontFamily=Helvetica;fontSize=26;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="25" y="15" width="1070" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Execution stages, not separate hardware copies · one NPU Core is reused" style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#43576a;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="25" y="57" width="1070" height="30" as="geometry"/></mxCell><mxCell id="start" value="1 · Prepare&#xa;RAM parameters / fixed Demo" style="rounded=1;whiteSpace=wrap;html=0;arcSize=10;fillColor=#faf2e2;strokeColor=#b49b6b;strokeWidth=1.5;fontColor=#23374a;fontFamily=Helvetica;fontSize=18;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="230" height="85" as="geometry"/></mxCell><mxCell id="l1" value="2 · Load W1 → start&#xa;Wait for Core result" style="rounded=1;whiteSpace=wrap;html=0;arcSize=10;fillColor=#faf2e2;strokeColor=#b49b6b;strokeWidth=1.5;fontColor=#23374a;fontFamily=Helvetica;fontSize=18;spacing=10;" vertex="1" parent="1"><mxGeometry x="395" y="150" width="245" height="85" as="geometry"/></mxCell><mxCell id="h" value="3 · Capture hidden_result&#xa;Write H to RAM" style="rounded=1;whiteSpace=wrap;html=0;arcSize=10;fillColor=#eaf4ef;strokeColor=#729c86;strokeWidth=1.5;fontColor=#23374a;fontFamily=Helvetica;fontSize=18;spacing=10;" vertex="1" parent="1"><mxGeometry x